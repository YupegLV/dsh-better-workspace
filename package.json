{
  "name": "dsh-virtual-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "DSH web plugin: a REAL virtual directory tree for the sidebar. Directories are first-class records you create, name, nest and reorder freely; the real (host) workspaces hang off them as leaves and are never renamed — their titles and paths stay exactly as they are. Derived from dsh-better-workspace (MIT), whose title-prefix projection is kept only as a fallback.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "LICENSE",
    "tests/smoke.mjs"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "workspace",
    "virtual-directory"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
